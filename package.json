{
  "name": "aux",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src tests docs *.ts *.mjs *.mts *.yaml README.md AGENTS.md",
    "worker": "tsx --conditions=react-server --env-file-if-exists=.env.local src/workers/playback.ts",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.1",
    "@radix-ui/react-dialog": "1.3.1",
    "better-sqlite3": "13.0.3",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "redis": "6.3.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tsx": "4.23.15",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "description": "Collaborative music sessions with a shared queue across multiple music services.",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12.16.1 <13"
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module"
}
