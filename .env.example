# Copy to .env.local; never commit credentials.
REDIS_URL=redis://127.0.0.1:6379
# Get a Spotify developer app Client ID; PKCE does not use a client secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUX_TOKEN_ENCRYPTION_KEY=
# Optional absolute persistent SQLite directory. Web and worker MUST share this.
# AUX_DATA_DIR=/absolute/path/to/aux-data
